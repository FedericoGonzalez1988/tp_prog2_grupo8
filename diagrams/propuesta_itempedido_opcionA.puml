@startuml Propuesta ItemPedido

title Propuesta: separar Producto (menu) de ItemPedido (pedido)\nOpcion A - Composite en el item del pedido

set separator none
skinparam classAttributeIconSize 0

legend top right
  Verde: clase nueva
  Amarillo: clase existente que cambia
  Blanco: sin cambios
endlegend

' ===================== MENU (catalogo, SIN estado) =====================

package "Menu (catalogo)" {

    class Menu {
        -items: Comida[]
        +agregarItem(item: Comida): void
        +quitarItem(item: Comida): void
        +getItems(): Comida[]
    }

    abstract class Comida #FCF3CF {
        -nombre: string
        -disponible: boolean
        +{abstract} getPrecio(): number
        +{abstract} crearItemPedido(cantidad: number): ItemPedido
        +getNombre(): string
        +setNombre(nombre: string): void
        +getDisponible(): boolean
        +setDisponible(disponible: boolean): void
    }
    note right of Comida
      Se ELIMINA estaListo():
      un producto del catalogo
      no tiene estado.
      Se AGREGA crearItemPedido()
      (Factory Method): cada tipo de
      Comida sabe que ItemPedido crear,
      sin usar instanceof en Pedido.
    end note

    class Producto #FCF3CF {
        -precio: number
        -estacion: Estacion
        +getPrecio(): number
        +setPrecio(precio: number): void
        +getEstacion(): Estacion
        +setEstacion(estacion: Estacion): void
        +crearItemPedido(cantidad: number): ItemPedido
    }
    note bottom of Producto
      Ex "Item". Pierde:
      estado, avanzarEstado(), estaListo()
    end note

    class Combo #FCF3CF {
        -idCombo: string
        -productos: Producto[]
        -estrategiaCalculo: IEstrategiaPrecioCombo
        +getIdCombo(): string
        +getPrecio(): number
        +getProductos(): Producto[]
        +crearItemPedido(cantidad: number): ItemPedido
    }

    interface IEstrategiaPrecioCombo {
        +calcularPrecio(precioOriginal: number): number
    }
    class EstrategiaComboPorcentaje implements IEstrategiaPrecioCombo {
        -porcentaje: number
    }
    class EstrategiaComboPrecioFijo implements IEstrategiaPrecioCombo {
        -precioFijo: number
    }
}

Comida <|-- Producto
Comida <|-- Combo
Menu o-- "*" Comida
Combo o-- "2..*" Producto
Combo --> IEstrategiaPrecioCombo

' ===================== PEDIDO (instancias, CON estado) =====================

package "Pedidos" {

    abstract class Pedido #FCF3CF {
        -numeroPedido: string
        -items: ItemPedido[]
        -estado: IEstadoPedido
        +getNumeroPedido(): string
        +getItems(): ItemPedido[]
        +agregarProducto(producto: Comida, cantidad: number = 1): void
        +quitarItem(item: ItemPedido): void
        +confirmar(): void
        +marcarListo(): void
        +calcularTotal(): number
        +puedeFacturarse(): boolean
        #deshacerUltimo(): ItemPedido | null
        #quitarHasta(item: ItemPedido): void
        -validarPedidoModificable(): void
    }
    note right of Pedido
      Todo lo que modifica el pedido llama antes a
      validarPedidoModificable(): si estado.puedeModificar()
      es false lanza ErrorPedidoYaConfirmado.
      agregarProducto():
        items.push(producto.crearItemPedido(cantidad))
      quitarItem():
        item.validarModificacion() antes de quitar
      confirmar():
        estado = estado.confirmar()
        items.forEach(i => i.enviarACocina())
      puedeFacturarse():
        estado.puedeFacturarse() && items.every(i => i.estaListo())
      deshacerUltimo() / quitarHasta(): protegidos, los
        exponen solo los pedidos que implementan IPedidoModificable
    end note

    class PedidoSalon {
        -mesa: string
        -mozo: Empleado
        +deshacerUltimoItem(): ItemPedido | null
        +quitarHastaItem(item: ItemPedido): void
    }
    class PedidoParaLlevar {
        -horario: Date
        +deshacerUltimoItem(): ItemPedido | null
        +quitarHastaItem(item: ItemPedido): void
    }
    class PedidoDelivery {
        -cadete: Empleado
        -direccion: string
        -costoEnvio: number
    }
    interface IPedidoModificable {
        +deshacerUltimoItem(): ItemPedido | null
        +quitarHastaItem(item: ItemPedido): void
    }

    abstract class ItemPedido #D5F5E3 {
        -cantidad: number
        +getCantidad(): number
        +{abstract} getSubtotal(): number
        +{abstract} estaListo(): boolean
        +{abstract} validarModificacion(): void
        +{abstract} enviarACocina(): void
    }

    class ItemPedidoSimple #D5F5E3 {
        -producto: Producto
        -estado: IEstadoItem
        +getProducto(): Producto
        +getNombreEstado(): string
        +getSubtotal(): number
        +avanzarEstado(): void
        +estaListo(): boolean
        +validarModificacion(): void
        +enviarACocina(): void
    }
    note bottom of ItemPedidoSimple
      getSubtotal() = producto.getPrecio() * cantidad
      validarModificacion() = estado.validarModificacion()
      enviarACocina() = producto.getEstacion().recibirItem(this)
    end note

    class ItemPedidoCombo #D5F5E3 {
        -combo: Combo
        -componentes: ItemPedidoSimple[]
        +getCombo(): Combo
        +getComponentes(): ItemPedidoSimple[]
        +getSubtotal(): number
        +estaListo(): boolean
        +validarModificacion(): void
        +enviarACocina(): void
    }
    note bottom of ItemPedidoCombo
      Al crearse arma un ItemPedidoSimple
      por cada producto del combo.
      getSubtotal() = combo.getPrecio() * cantidad
      estaListo() = todos los componentes listos
      validarModificacion() = valida cada componente
      enviarACocina() = cada componente va a SU estacion
    end note
}

Pedido <|-- PedidoSalon
Pedido <|-- PedidoParaLlevar
Pedido <|-- PedidoDelivery
IPedidoModificable <|.. PedidoSalon
IPedidoModificable <|.. PedidoParaLlevar

Pedido *-- "*" ItemPedido
ItemPedido <|-- ItemPedidoSimple
ItemPedido <|-- ItemPedidoCombo
ItemPedidoCombo *-- "2..*" ItemPedidoSimple : componentes
ItemPedidoSimple --> "1" Producto
ItemPedidoCombo --> "1" Combo

Producto ..> ItemPedidoSimple : <<crea>>
Combo ..> ItemPedidoCombo : <<crea>>

' ===================== Estados =====================

package "Estados del item (State)" {
    interface IEstadoItem {
        +siguienteEstado(): IEstadoItem
        +validarModificacion(): void
        +getNombre(): string
        +estaListo(): boolean
    }
    class EstadoItemPendiente implements IEstadoItem
    class EstadoItemEnPreparacion implements IEstadoItem
    class EstadoItemListo implements IEstadoItem
}
note bottom of IEstadoItem
  validarModificacion() YA EXISTE:
  Pendiente -> no hace nada
  EnPreparacion / Listo -> lanza ErrorItemNoModificable
end note

ItemPedidoSimple *-- "1" IEstadoItem
EstadoItemPendiente ..> EstadoItemEnPreparacion
EstadoItemEnPreparacion ..> EstadoItemListo

package "Estados del pedido (State)" {
    interface IEstadoPedido {
        +puedeModificar(): boolean
        +puedeFacturarse(): boolean
        +confirmar(): IEstadoPedido
        +marcarListo(): IEstadoPedido
    }
    class EstadoEnConstruccion implements IEstadoPedido
    class EstadoConfirmado implements IEstadoPedido
    class EstadoListo implements IEstadoPedido
}

Pedido *-- "1" IEstadoPedido
EstadoEnConstruccion ..> EstadoConfirmado
EstadoConfirmado ..> EstadoListo

' ===================== Estaciones =====================

package "Cocina" {
    abstract class Estacion #FCF3CF {
        -nombreEstacion: string
        -itemsEstacion: Cola<ItemPedidoSimple>
        +getNombreEstacion(): string
        +setNombreEstacion(nombreEstacion: string): void
        +recibirItem(item: ItemPedidoSimple): void
        +procesarSiguiente(): ItemPedidoSimple | undefined
    }
    note bottom of Estacion
      Ahora encola ItemPedidoSimple
      (la linea del pedido), no el
      producto del catalogo.
      procesarSiguiente(): toma el siguiente
      en orden FIFO, lo pasa a "en preparacion"
      y lo DEVUELVE para que el cocinero lo
      marque listo (item.avanzarEstado()).
    end note
    class Parrilla
    class CocinaFria
    class Barra
    class CocinaDulce

    class "Cola<T>" as Cola
    class "MyNode<T>" as MyNode
}

Estacion <|-- Parrilla
Estacion <|-- CocinaFria
Estacion <|-- Barra
Estacion <|-- CocinaDulce
Estacion *-- Cola
Cola *-- MyNode
Producto "*" -right-> "1" Estacion
ItemPedidoSimple "*" --o Estacion : (via Cola)

' ===================== Empleado =====================

class Empleado #FCF3CF {
    -nombre: string
    -cuil: string
    -sector: string
    +getNombre(): string
    +getCuil(): string
    +getSector(): string
    +agregarItem(pedido: Pedido, producto: Comida, cantidad: number = 1): void
    +corregirItem(pedido: IPedidoModificable, item: ItemPedido): void
}
PedidoSalon --> Empleado : mozo
PedidoDelivery --> Empleado : cadete
Empleado ..> Pedido
Empleado ..> IPedidoModificable

@enduml
